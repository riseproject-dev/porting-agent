{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Structured agent result (untrusted input to trusted handlers)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contribution_id",
    "diagnosis",
    "expected_head",
    "expected_revision",
    "operation",
    "outcome",
    "progress",
    "reconstruction_base",
    "ref",
    "schema_version"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "contribution_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,127}$"
    },
    "outcome": {
      "enum": [
        "patch",
        "investigation",
        "no_change",
        "blocked",
        "needs_clarification",
        "park_recommended"
      ]
    },
    "expected_revision": {
      "type": "integer",
      "minimum": 0
    },
    "expected_head": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{40}$"
    },
    "reason_ids": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "string",
        "maxLength": 200
      }
    },
    "feedback_responses": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["comment_id", "summary"],
        "properties": {
          "comment_id": {"type": "integer", "minimum": 1},
          "summary": {"type": "string", "minLength": 1, "maxLength": 1000}
        }
      }
    },
    "patch_digest": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "changed_files": {
      "type": "array",
      "maxItems": 300,
      "items": {
        "type": "string",
        "maxLength": 500
      }
    },
    "operation": {
      "enum": [
        "append",
        "rewrite",
        "none"
      ]
    },
    "diagnosis": {
      "type": "string",
      "maxLength": 16000
    },
    "validation_performed": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 1000
      }
    },
    "validation_not_performed": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 1000
      }
    },
    "reproduction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image", "architecture", "commands", "workflows", "limits"],
      "properties": {
        "image": {
          "type": "string",
          "pattern": "^ghcr\\.io/riseproject-dev/porting-agent/ubuntu-24\\.04-riscv@sha256:[0-9a-f]{64}$"
        },
        "architecture": {"const": "riscv64"},
        "commands": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["command", "exit_status", "log_sha256"],
            "properties": {
              "command": {"type": "string", "minLength": 1, "maxLength": 2000},
              "exit_status": {"type": "integer", "minimum": 0, "maximum": 255},
              "log_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            }
          }
        },
        "workflows": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["workflow", "jobs", "runner_mappings"],
            "properties": {
              "workflow": {"type": "string", "minLength": 1, "maxLength": 500},
              "jobs": {
                "type": "array", "minItems": 1, "maxItems": 64,
                "items": {"type": "string", "minLength": 1, "maxLength": 200}
              },
              "runner_mappings": {
                "type": "array", "minItems": 1, "maxItems": 32,
                "items": {"type": "string", "minLength": 1, "maxLength": 1000}
              }
            }
          }
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": ["wall_seconds", "memory_bytes", "pids", "artifact_bytes", "log_bytes"],
          "properties": {
            "wall_seconds": {"type": "integer", "minimum": 1, "maximum": 14400},
            "memory_bytes": {"type": "integer", "minimum": 1, "maximum": 34359738368},
            "pids": {"type": "integer", "minimum": 1, "maximum": 4096},
            "artifact_bytes": {"type": "integer", "minimum": 0, "maximum": 4194304},
            "log_bytes": {"type": "integer", "minimum": 0, "maximum": 16777216}
          }
        }
      }
    },
    "release_effects": {
      "type": "string",
      "maxLength": 4000
    },
    "optimization_effects": {
      "type": "string",
      "maxLength": 4000
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 1000
      }
    },
    "failure_cluster": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 200
    },
    "progress": {
      "enum": [
        "new_causal_evidence",
        "requirement_fixed",
        "acceptance_row_satisfied",
        "prerequisite_resolved",
        "none"
      ]
    },
    "attempt_cost": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_tokens",
        "wall_seconds"
      ],
      "properties": {
        "model_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "wall_seconds": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "work_id": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 200
    },
    "claim_id": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 200
    },
    "fork_repository_id": {
      "type": [
        "integer",
        "null"
      ]
    },
    "ref": {
      "const": "riscv64"
    },
    "reconstruction_base": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{40}$"
    },
    "proposed_tree": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{40}$"
    }
  }
}
