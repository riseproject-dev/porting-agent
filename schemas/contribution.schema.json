{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Upstreaming contribution lifecycle record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contribution_id",
    "project_id",
    "revision",
    "generation",
    "refresh",
    "phase",
    "activity",
    "paused",
    "paused_at",
    "paused_reason",
    "paused_by",
    "parked_reason",
    "terminal_reason",
    "previous_phase",
    "tracking_issue",
    "owners",
    "admission_class",
    "admission_override",
    "automatic_refresh_used",
    "distributions",
    "upstream",
    "fork",
    "upstream_pr",
    "target_contract_id",
    "prerequisite_ids",
    "active_operation_id",
    "queue_work_id",
    "queue_claim_handle",
    "queue_result_id",
    "debug_commits",
    "clean_head_sha",
    "clean_head_ci_since",
    "submission_rewrite_id",
    "submission_review_id",
    "handoff_request",
    "handoff_approval",
    "last_ci_evidence_id",
    "merge",
    "retirement",
    "release_acceptance",
    "budget",
    "pending_human_action",
    "follows",
    "next_poll_at",
    "created_at",
    "updated_at",
    "proposal_artifact",
    "publication_operation_id",
    "pending_publication",
    "held_patch",
    "review_comments",
    "processed_publications",
    "processed_review_ids",
    "processed_review_comment_ids",
    "processed_pr_conversation_comment_ids",
    "pending_feedback_evidence_ids",
    "active_work",
    "plan_evidence_id",
    "scope_coverage_complete",
    "scope_paths"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "contribution_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,127}$"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,127}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "generation": {
      "type": "integer",
      "minimum": 0
    },
    "refresh": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "command_id",
            "reason",
            "from_phase",
            "head_sha",
            "pr_number"
          ],
          "properties": {
            "command_id": {
              "type": "string",
              "maxLength": 200
            },
            "reason": {
              "type": "string",
              "maxLength": 2000
            },
            "from_phase": {
              "enum": [
                "provisioning",
                "development",
                "handoff"
              ]
            },
            "head_sha": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[0-9a-f]{40}$"
            },
            "pr_number": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            }
          }
        }
      ]
    },
    "phase": {
      "enum": [
        "queued",
        "planning",
        "provisioning",
        "development",
        "handoff",
        "upstream_review",
        "release_wait",
        "released",
        "parked",
        "closed"
      ]
    },
    "activity": {
      "enum": [
        "idle",
        "agent_running",
        "waiting_human",
        "review_pending",
        "reviewing",
        "publishing",
        "waiting_ci",
        "fix_needed",
        "awaiting_submission",
        "review_due",
        "building_upstream_branch",
        "preparing_submission",
        "waiting_upstream_pr"
      ]
    },
    "paused": {
      "type": "boolean"
    },
    "paused_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "paused_reason": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 2000
    },
    "paused_by": {
      "enum": [
        "human",
        "controller",
        null
      ]
    },
    "paused_at_commit": {
      "description": "The version of the pipeline code that ran when the controller paused the contribution after a processing error: the SHA-256 of the top-level git tree of HEAD without .state (reconcile.pipeline_version), a tree hash and not a commit id.",
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "parked_reason": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 2000
    },
    "terminal_reason": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 2000
    },
    "previous_phase": {
      "enum": [
        "queued",
        "planning",
        "provisioning",
        "development",
        "handoff",
        "upstream_review",
        "release_wait",
        "released",
        "parked",
        "closed",
        null
      ]
    },
    "tracking_issue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "number"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "number": {
          "type": "integer",
          "minimum": 1
        },
        "url": {
          "type": "string",
          "pattern": "^https://github\\.com/riseproject-dev/porting-agent/issues/[0-9]+$"
        },
        "description": {
          "type": "string",
          "maxLength": 16384
        },
        "description_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "notes": {
          "type": "string",
          "maxLength": 16384
        }
      }
    },
    "owners": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary",
        "backup",
        "submitter",
        "handoff_reviewer"
      ],
      "properties": {
        "primary": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "login"
              ],
              "properties": {
                "id": {
                  "type": "integer",
                  "minimum": 1
                },
                "login": {
                  "type": "string",
                  "maxLength": 39
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "backup": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "login"
              ],
              "properties": {
                "id": {
                  "type": "integer",
                  "minimum": 1
                },
                "login": {
                  "type": "string",
                  "maxLength": 39
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "submitter": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "login"
              ],
              "properties": {
                "id": {
                  "type": "integer",
                  "minimum": 1
                },
                "login": {
                  "type": "string",
                  "maxLength": 39
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "handoff_reviewer": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "login"
              ],
              "properties": {
                "id": {
                  "type": "integer",
                  "minimum": 1
                },
                "login": {
                  "type": "string",
                  "maxLength": 39
                }
              }
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "admission_class": {
      "enum": [
        "configuration_integration",
        "architecture_correctness",
        "optimized_backend",
        null
      ]
    },
    "admission_override": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "class": {
              "enum": [
                "configuration_integration",
                "architecture_correctness",
                "optimized_backend"
              ]
            },
            "paths": {
              "type": "array",
              "maxItems": 64,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              }
            },
            "reason": {
              "type": "string",
              "maxLength": 2000
            }
          }
        }
      ]
    },
    "automatic_refresh_used": {
      "type": "boolean"
    },
    "distributions": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "string",
        "pattern": "^@?[A-Za-z0-9]([A-Za-z0-9._/:+-]{0,198}[A-Za-z0-9])?$"
      }
    },
    "upstream": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository_id",
        "full_name",
        "base_ref",
        "base_sha"
      ],
      "properties": {
        "repository_id": {
          "type": [
            "integer",
            "null"
          ]
        },
        "full_name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "base_ref": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 255
        },
        "base_sha": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "fork": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repository_id",
            "name",
            "head_ref",
            "head_sha",
            "pr_number"
          ],
          "properties": {
            "repository_id": {
              "type": [
                "integer",
                "null"
              ]
            },
            "name": {
              "type": "string",
              "pattern": "^riseproject-upstreaming/[A-Za-z0-9_.-]+$"
            },
            "head_ref": {
              "enum": [
                "riscv64-dev",
                "riscv64"
              ]
            },
            "head_sha": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[0-9a-f]{40}$"
            },
            "pr_number": {
              "type": [
                "integer",
                "null"
              ]
            }
          }
        }
      ]
    },
    "upstream_pr": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "number",
            "url",
            "head_repository_id",
            "head_ref",
            "head_sha",
            "base_ref",
            "registered_by"
          ],
          "properties": {
            "id": {
              "type": "integer"
            },
            "number": {
              "type": "integer"
            },
            "url": {
              "type": "string"
            },
            "head_repository_id": {
              "type": "integer"
            },
            "head_ref": {
              "type": "string"
            },
            "head_sha": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "base_ref": {
              "type": "string"
            },
            "registered_by": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "login"
              ],
              "properties": {
                "id": {
                  "type": "integer",
                  "minimum": 1
                },
                "login": {
                  "type": "string",
                  "maxLength": 39
                }
              }
            }
          }
        }
      ]
    },
    "target_contract_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,127}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "prerequisite_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,127}$"
      }
    },
    "active_operation_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,127}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "queue_work_id": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 200
    },
    "queue_claim_handle": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 200
    },
    "queue_result_id": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 200
    },
    "debug_commits": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sha",
          "subject",
          "reason"
        ],
        "properties": {
          "sha": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "subject": {
            "type": "string",
            "pattern": "^\\{debug\\}"
          },
          "reason": {
            "type": "string",
            "maxLength": 500
          }
        }
      }
    },
    "clean_head_sha": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{40}$"
    },
    "clean_head_ci_since": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "submission_rewrite_id": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,127}$"
        }
      ]
    },
    "submission_review_id": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,127}$"
        }
      ]
    },
    "handoff_request": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "command_id",
            "head",
            "revision"
          ],
          "properties": {
            "command_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,127}$"
            },
            "head": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "revision": {
              "type": "integer"
            }
          }
        }
      ]
    },
    "handoff_approval": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "command_id",
            "actor",
            "head",
            "revision",
            "evidence_ids"
          ],
          "properties": {
            "command_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,127}$"
            },
            "actor": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "login"
              ],
              "properties": {
                "id": {
                  "type": "integer",
                  "minimum": 1
                },
                "login": {
                  "type": "string",
                  "maxLength": 39
                }
              }
            },
            "head": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "revision": {
              "type": "integer"
            },
            "evidence_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,127}$"
              }
            }
          }
        }
      ]
    },
    "last_ci_evidence_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,127}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "merge": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "merge_sha",
            "merged_at",
            "target_ref",
            "evidence_id"
          ],
          "properties": {
            "merge_sha": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "merged_at": {
              "type": "string",
              "format": "date-time"
            },
            "target_ref": {
              "type": "string"
            },
            "evidence_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,127}$"
            }
          }
        }
      ]
    },
    "retirement": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "branch_deleted",
            "fork_archived",
            "issue_closed",
            "operation_ids"
          ],
          "properties": {
            "branch_deleted": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "fork_archived": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "issue_closed": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "operation_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,127}$"
              }
            }
          }
        }
      ]
    },
    "release_acceptance": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "evidence_id",
            "as_of",
            "complete"
          ],
          "properties": {
            "evidence_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,127}$"
            },
            "as_of": {
              "type": "string",
              "format": "date-time"
            },
            "complete": {
              "type": "boolean"
            }
          }
        }
      ]
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_id",
        "attempts_used",
        "no_progress_streak",
        "clusters",
        "planning_attempts",
        "spent_estimate_usd_cents",
        "reruns"
      ],
      "properties": {
        "policy_id": {
          "type": "string"
        },
        "attempts_used": {
          "type": "integer",
          "minimum": 0
        },
        "no_progress_streak": {
          "type": "integer",
          "minimum": 0
        },
        "clusters": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "planning_attempts": {
          "type": "integer",
          "minimum": 0
        },
        "review_rejections": {
          "type": "integer",
          "minimum": 0
        },
        "source_unavailable": {
          "type": "integer",
          "minimum": 0
        },
        "source_unavailable_since": {
          "type": "string",
          "format": "date-time"
        },
        "source_unavailable_at": {
          "type": "string",
          "format": "date-time"
        },
        "source_unavailable_repository": {
          "type": "integer",
          "minimum": 0
        },
        "spent_estimate_usd_cents": {
          "type": "integer",
          "minimum": 0
        },
        "reruns": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "head_sha",
            "flaky",
            "interrupted"
          ],
          "properties": {
            "head_sha": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[0-9a-f]{40}$"
            },
            "flaky": {
              "type": "integer",
              "minimum": 0
            },
            "interrupted": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "pending_human_action": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "requested_at",
            "reminded_at",
            "escalated_at",
            "counter"
          ],
          "properties": {
            "kind": {
              "type": "string"
            },
            "requested_at": {
              "type": "string",
              "format": "date-time"
            },
            "reminded_at": {
              "type": [
                "string",
                "null"
              ],
              "format": "date-time"
            },
            "escalated_at": {
              "type": [
                "string",
                "null"
              ],
              "format": "date-time"
            },
            "counter": {
              "enum": [
                "work_total",
                "work_recovery",
                "planning_attempts",
                "repair_attempts_cluster",
                "no_progress",
                "dev_reviews",
                "flaky_reruns",
                "interrupted_reruns",
                "dispatch_recovery",
                "publish_recovery",
                "source_reads",
                "operation_launch",
                "upstream_branch",
                "submission_comment",
                null
              ]
            }
          }
        }
      ]
    },
    "follows": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,127}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "next_poll_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "proposal_artifact": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "work_id",
            "claim_id",
            "artifact_id",
            "name",
            "digest",
            "run_id"
          ],
          "properties": {
            "work_id": {
              "type": "string"
            },
            "claim_id": {
              "type": "string"
            },
            "artifact_id": {
