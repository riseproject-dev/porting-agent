{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Upstream planning research-completeness contract",
  "type": "object",
  "required": ["schema_version", "contribution_id", "expected_revision", "tracking_issue_description_digest", "summary", "research", "history", "maintainers", "dependency_graph", "ecosystem_report", "proposal"],
  "properties": {
    "schema_version": {"enum": [1, 2, 3, 4]},
    "contribution_id": {"type": "string", "minLength": 1, "maxLength": 127},
    "expected_revision": {"type": "integer", "minimum": 0},
    "tracking_issue_description_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "summary": {"type": "string", "minLength": 40, "maxLength": 8000},
    "research": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tracking_issue", "upstream_issues", "upstream_pull_requests", "ci_history", "documentation", "website", "mailing_lists", "blogs", "maintainer_reviews", "release_repositories", "ecosystem_report"],
      "properties": {
        "tracking_issue": {"$ref": "#/$defs/research"},
        "upstream_issues": {"$ref": "#/$defs/research"},
        "upstream_pull_requests": {"$ref": "#/$defs/research"},
        "ci_history": {"$ref": "#/$defs/research"},
        "documentation": {"$ref": "#/$defs/research"},
        "website": {"$ref": "#/$defs/research"},
        "mailing_lists": {"$ref": "#/$defs/research"},
        "blogs": {"$ref": "#/$defs/research"},
        "maintainer_reviews": {"$ref": "#/$defs/research"},
        "release_repositories": {"$ref": "#/$defs/research"},
        "ecosystem_report": {"$ref": "#/$defs/research"}
      }
    },
    "history": {
      "type": "array", "maxItems": 200,
      "items": {
        "type": "object",
        "required": ["url", "outcome", "decision", "reviewers", "review_urls"],
        "properties": {
          "url": {"$ref": "#/$defs/url"},
          "outcome": {"enum": ["accepted", "rejected", "open", "closed_unmerged", "superseded"]},
          "decision": {"type": "string", "minLength": 20, "maxLength": 4000},
          "reviewers": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "review_urls": {"type": "array", "items": {"$ref": "#/$defs/url"}}
        }
      }
    },
    "maintainers": {
      "type": "array", "minItems": 1, "maxItems": 100,
      "items": {
        "type": "object", "required": ["name", "role", "sources"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "role": {"type": "string", "minLength": 10, "maxLength": 2000},
          "sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/url"}}
        }
      }
    },
    "dependency_graph": {
      "type": "object",
      "required": ["tool", "success", "canonical_project", "query", "result", "assessment"],
      "properties": {
        "tool": {"const": "project_graph_query"},
        "success": {"const": true},
        "canonical_project": {"type": "string", "minLength": 1, "maxLength": 200},
        "query": {"type": "object", "minProperties": 1},
        "result": {"type": ["object", "array"], "minProperties": 1, "minItems": 1},
        "assessment": {"type": "string", "minLength": 40, "maxLength": 8000}
      }
    },
    "ecosystem_report": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {"enum": ["available", "absent"]},
        "url": {"$ref": "#/$defs/url"},
        "revision": {"type": "string", "minLength": 1, "maxLength": 100},
        "riscv64_status": {"type": "string", "minLength": 40, "maxLength": 8000},
        "used_findings": {
          "type": "object", "additionalProperties": false,
          "required": ["support_status", "dependencies", "prior_work_and_blockers"],
          "properties": {
            "support_status": {"type": "string", "minLength": 40, "maxLength": 4000},
            "dependencies": {"type": "string", "minLength": 40, "maxLength": 4000},
            "prior_work_and_blockers": {"type": "string", "minLength": 40, "maxLength": 4000}
          }
        },
        "corroboration_and_conflicts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/url"}}
      },
      "if": {"properties": {"status": {"const": "available"}}},
      "then": {"required": ["url", "revision", "riscv64_status", "used_findings", "corroboration_and_conflicts"]}
    },
    "proposal": {
      "type": "object",
      "additionalProperties": true,
      "required": ["decision", "rationale", "admission_class", "allowed_paths", "path_coverage"],
      "properties": {
        "decision": {"enum": ["develop", "park", "close"]},
        "rationale": {"type": "string", "minLength": 40, "maxLength": 8000},
        "admission_class": {"enum": ["configuration_integration", "architecture_correctness", "optimized_backend", null]},
        "allowed_paths": {
          "type": "array", "maxItems": 32,
          "items": {"type": "string", "minLength": 1, "maxLength": 200}
        },
        "path_coverage": {
          "type": "array", "minItems": 6, "maxItems": 6,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["area", "paths", "assessment"],
            "properties": {
              "area": {"enum": ["build", "test", "release", "packaging", "documentation", "native_sources"]},
              "paths": {"type": "array", "maxItems": 32, "items": {"type": "string", "minLength": 1, "maxLength": 200}},
              "assessment": {"type": "string", "minLength": 20, "maxLength": 4000}
            }
          }
        }
      },
      "allOf": [
        {
          "if": {"properties": {"decision": {"const": "develop"}}},
          "then": {"properties": {"admission_class": {"type": "string"}, "allowed_paths": {"minItems": 1}}}
        },
        {
          "if": {"properties": {"decision": {"const": "park"}}},
          "then": {"properties": {"admission_class": {"type": "null"}, "allowed_paths": {"maxItems": 0}}}
        },
        {
          "if": {"properties": {"decision": {"const": "close"}}},
          "then": {"properties": {"admission_class": {"type": "null"}, "allowed_paths": {"maxItems": 0}}}
        }
      ]
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["languages", "build_systems", "build_and_test", "release_channels", "riscv64_toolchain"],
      "properties": {
        "languages": {"type": "array", "minItems": 1, "maxItems": 10, "items": {"type": "string", "minLength": 1, "maxLength": 40}},
        "build_systems": {"type": "array", "minItems": 1, "maxItems": 10, "items": {"type": "string", "minLength": 1, "maxLength": 100}},
        "build_and_test": {"type": "string", "minLength": 20, "maxLength": 4000},
        "release_channels": {
          "type": "array", "maxItems": 20,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["kind", "name", "url", "riscv64", "evidence"],
            "properties": {
              "kind": {"enum": ["pypi", "crates_io", "npm", "go_module", "maven", "container_image", "github_release", "distribution_package", "other"]},
              "name": {"type": "string", "minLength": 1, "maxLength": 200},
              "url": {"$ref": "#/$defs/url"},
              "riscv64": {"enum": ["published", "absent", "not_applicable"]},
              "evidence": {"type": "string", "minLength": 1, "maxLength": 2000}
            }
          }
        },
        "riscv64_toolchain": {"type": "string", "minLength": 20, "maxLength": 4000}
      }
    },
    "contribution_guidelines": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pull_request_template",
        "contributing",
        "commit_conventions",
        "reviewers"
      ],
      "properties": {
        "pull_request_template": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "searched",
            "sources",
            "templates"
          ],
          "properties": {
            "status": {
              "enum": [
                "found",
                "none_found"
              ]
            },
            "searched": {
              "type": "array",
              "minItems": 1,
              "maxItems": 50,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              }
            },
            "sources": {
              "type": "array",
              "minItems": 1,
              "maxItems": 100,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "url",
                  "finding"
                ],
                "properties": {
                  "url": {
                    "$ref": "#/$defs/url"
                  },
                  "finding": {
                    "type": "string",
                    "minLength": 20,
                    "maxLength": 4000
                  }
                }
              }
            },
            "templates": {
              "type": "array",
              "maxItems": 10,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "url",
                  "content",
                  "required_sections",
                  "checklist_items"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 300
                  },
                  "url": {
                    "$ref": "#/$defs/url"
                  },
                  "content": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 8000
                  },
                  "required_sections": {
                    "type": "array",
                    "maxItems": 30,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    }
                  },
                  "checklist_items": {
                    "type": "array",
                    "maxItems": 50,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 500
                    }
                  }
                }
              }
            }
          }
        },
        "contributing": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "searched",
            "sources",
            "documents",
            "instructions"
          ],
          "properties": {
            "status": {
              "enum": [
                "found",
                "none_found"
              ]
            },
            "searched": {
              "type": "array",
              "minItems": 1,
              "maxItems": 50,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              }
            },
            "sources": {
              "type": "array",
              "minItems": 1,
              "maxItems": 100,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "url",
                  "finding"
                ],
                "properties": {
                  "url": {
                    "$ref": "#/$defs/url"
                  },
                  "finding": {
                    "type": "string",
                    "minLength": 20,
                    "maxLength": 4000
                  }
                }
              }
            },
            "documents": {
              "type": "array",
              "maxItems": 10,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "url",
                  "summary"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 300
                  },
                  "url": {
                    "$ref": "#/$defs/url"
                  },
                  "summary": {
                    "type": "string",
                    "minLength": 20,
                    "maxLength": 8000
                  }
                }
              }
            },
            "instructions": {
              "type": "array",
              "maxItems": 60,
              "items": {
                "type": "string",
                "minLength": 5,
                "maxLength": 1000
              }
            }
          }
        },
        "commit_conventions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sources",
            "sample",
            "title_lengths",
            "rules",
            "observations",
            "examples"
          ],
          "properties": {
            "sources": {
              "type": "array",
              "minItems": 1,
              "maxItems": 100,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "url",
                  "finding"
                ],
                "properties": {
                  "url": {
                    "$ref": "#/$defs/url"
                  },
                  "finding": {
                    "type": "string",
                    "minLength": 20,
                    "maxLength": 4000
                  }
                }
              }
            },
            "sample": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "commits",
                "range"
              ],
              "properties": {
                "commits": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 5000
                },
                "range": {
                  "type": "string",
                  "minLength": 3,
                  "maxLength": 500
                }
              }
            },
            "title_lengths": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "median",
                "p90",
                "max"
              ],
              "properties": {
                "median": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1000
                },
                "p90": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1000
                },
                "max": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1000
                }
              }
            },
            "rules": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "title_max_length",
                "title_prefixes",
                "title_prefix_required",
                "title_capitalization",
                "title_trailing_period",
                "body_required",
                "body_line_max_length",
                "signed_off_by_required",
                "max_commits"
              ],
              "properties": {
                "title_max_length": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 20,
                  "maximum": 200
                },
                "title_prefixes": {
                  "type": "array",
                  "maxItems": 20,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 40
                  }
                },
                "title_prefix_required": {
                  "type": "boolean"
                },
                "title_capitalization": {
                  "enum": [
                    "upper",
                    "lower",
                    "any"
                  ]
                },
                "title_trailing_period": {
                  "enum": [
                    "forbidden",
                    "any"
                  ]
                },
                "body_required": {
                  "type": "boolean"
                },
                "body_line_max_length": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 50,
                  "maximum": 200
                },
                "signed_off_by_required": {
                  "type": "boolean"
                },
                "max_commits": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 1,
                  "maximum": 50
                }
              }
            },
            "observations": {
              "type": "string",
              "minLength": 40,
              "maxLength": 8000
            },
            "examples": {
              "type": "array",
              "minItems": 1,
              "maxItems": 10,
              "items": {
                "type": "string",
                "minLength": 5,
                "maxLength": 1000
              }
            }
          }
        },
        "reviewers": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "searched",
            "sources",
            "paths",
            "expectations"
          ],
          "properties": {
            "status": {
              "enum": [
                "found",
                "none_found"
              ]
            },
            "searched": {
              "type": "array",
              "minItems": 1,
              "maxItems": 50,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              }
            },
            "sources": {
              "type": "array",
              "minItems": 1,
              "maxItems": 100,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "url",
                  "finding"
                ],
                "properties": {
                  "url": {
                    "$ref": "#/$defs/url"
                  },
                  "finding": {
                    "type": "string",
                    "minLength": 20,
                    "maxLength": 4000
                  }
                }
              }
            },
            "paths": {
              "type": "array",
              "maxItems": 32,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "codeowners",
                  "reviewers"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "codeowners": {
                    "type": "array",
                    "maxItems": 20,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100
                    }
                  },
                  "reviewers": {
                    "type": "array",
                    "maxItems": 20,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "login",
                        "role",
                        "review_urls",
                        "expectations"
                      ],
                      "properties": {
                        "login": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 100
                        },
                        "role": {
                          "type": "string",
                          "minLength": 3,
                          "maxLength": 500
                        },
                        "review_urls": {
                          "type": "array",
                          "minItems": 1,
                          "maxItems": 20,
                          "items": {
                            "$ref": "#/$defs/url"
                          }
                        },
                        "expectations": {
                          "type": "string",
                          "minLength": 20,
                          "maxLength": 4000
                        }
                      }
                    }
                  }
                }
              }
            },
            "expectations": {
              "type": "array",
              "maxItems": 40,
              "items": {
                "type": "string",
                "minLength": 10,
                "maxLength": 1000
              }
            }
          }
        },
        "series_requirements": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "description", "source_url", "paths"],
            "properties": {
              "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,39}$"},
              "description": {"type": "string", "minLength": 10, "maxLength": 300},
              "source_url": {"$ref": "#/$defs/url"},
              "paths": {
                "type": "array",
                "minItems": 1,
                "maxItems": 3,
                "items": {"type": "string", "minLength": 1, "maxLength": 120}
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "url": {"type": "string", "format": "uri", "pattern": "^https?://", "maxLength": 2000},
    "research": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "queries", "coverage", "sources", "findings"],
      "properties": {
        "status": {"enum": ["searched", "not_applicable"]},
        "queries": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"type": "string", "minLength": 3, "maxLength": 2000}},
        "coverage": {
          "type": "object", "additionalProperties": false,
          "required": ["complete", "scope"],
          "properties": {
            "complete": {"const": true},
            "scope": {"type": "string", "minLength": 30, "maxLength": 4000}
          }
        },
        "sources": {
          "type": "array", "minItems": 1, "maxItems": 200,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["url", "finding"],
            "properties": {
              "url": {"$ref": "#/$defs/url"},
              "finding": {"type": "string", "minLength": 20, "maxLength": 4000}
            }
          }
        },
        "findings": {"type": "string", "minLength": 40, "maxLength": 8000},
        "justification": {"type": "string", "minLength": 40, "maxLength": 4000}
      },
      "if": {"properties": {"status": {"const": "not_applicable"}}},
      "then": {"required": ["justification"]}
    }
  },
  "allOf": [
    {"if": {"properties": {"schema_version": {"const": 2}}, "required": ["schema_version"]},
     "then": {"required": ["contribution_guidelines"]}},
    {"if": {"properties": {"schema_version": {"const": 3}}, "required": ["schema_version"]},
     "then": {"required": ["contribution_guidelines", "project"]}},
    {"if": {"properties": {"schema_version": {"const": 4}}, "required": ["schema_version"]},
     "then": {"required": ["contribution_guidelines", "project"]}}
  ]
}
