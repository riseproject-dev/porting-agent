{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Worker report of one Work run (untrusted)",
  "description": "What the worker attempted and why, each approach and its outcome, what failed with its evidence, what remains open and the verification done. Trusted code stores it as worker_report evidence only when the Result of the run is accepted.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contribution_id",
    "expected_revision",
    "task",
    "history_digest",
    "summary",
    "attempted",
    "approaches",
    "failures",
    "open_items",
    "verification",
    "revisited"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "contribution_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 127
    },
    "expected_revision": {
      "type": "integer",
      "minimum": 0
    },
    "task": {
      "enum": [
        "development_patch",
        "development_repair",
        "upstream_revision",
        "submission_rewrite",
        "submission_review"
      ]
    },
    "history_digest": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "summary": {
      "type": "string",
      "maxLength": 1200,
      "minLength": 1
    },
    "attempted": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "what",
          "why"
        ],
        "properties": {
          "what": {
            "type": "string",
            "maxLength": 600,
            "minLength": 1
          },
          "why": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 1
          }
        }
      }
    },
    "approaches": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "description",
          "outcome",
          "evidence",
          "lesson"
        ],
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1
          },
          "description": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1
          },
          "outcome": {
            "enum": [
              "adopted",
              "abandoned",
              "failed",
              "inconclusive"
            ]
          },
          "evidence": {
            "type": "string",
            "maxLength": 2000
          },
          "lesson": {
            "type": "string",
            "maxLength": 600
          }
        }
      }
    },
    "failures": {
      "type": "array",
      "minItems": 0,
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "what",
          "evidence"
        ],
        "properties": {
          "what": {
            "type": "string",
            "maxLength": 600,
            "minLength": 1
          },
          "evidence": {
            "type": "string",
            "maxLength": 2000
          }
        }
      }
    },
    "open_items": {
      "type": "array",
      "minItems": 0,
      "maxItems": 30,
      "items": {
        "type": "string",
        "maxLength": 1000,
        "minLength": 1
      }
    },
    "verification": {
      "type": "array",
      "minItems": 0,
      "maxItems": 40,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "check",
          "result",
          "evidence"
        ],
        "properties": {
          "check": {
            "type": "string",
            "maxLength": 600,
            "minLength": 1
          },
          "result": {
            "enum": [
              "passed",
              "failed",
              "not_run"
            ]
          },
          "evidence": {
            "type": "string",
            "maxLength": 1000
          }
        }
      }
    },
    "revisited": {
      "type": "array",
      "minItems": 0,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "history_entry",
          "new_evidence"
        ],
        "properties": {
          "history_entry": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1
          },
          "new_evidence": {
            "type": "string",
            "maxLength": 1500,
            "minLength": 1
          }
        }
      }
    }
  }
}
