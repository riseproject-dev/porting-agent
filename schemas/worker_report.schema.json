{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Worker report of one Work run (untrusted)",
  "description": "What the worker attempted and why, each approach and its outcome, what failed with its evidence, what remains open and the verification done. The file is refused, and the Result with it, when it is larger than 32 KiB (32768 bytes) as written, so not every list and field can be at its maximum: summarise logs and cite commands, exit statuses, digests and links instead of pasting output. Trusted code stores it as worker_report evidence only when the Result of the run is accepted.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contribution_id",
    "expected_revision",
    "task",
    "history_digest",
    "summary",
    "attempted",
    "approaches",
    "failures",
    "open_items",
    "verification",
    "revisited"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "contribution_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 127
    },
    "expected_revision": {
      "type": "integer",
      "minimum": 0
    },
    "task": {
      "enum": [
        "development_patch",
        "development_repair",
        "upstream_revision",
        "submission_rewrite",
        "submission_review"
      ]
    },
    "history_digest": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "summary": {
      "type": "string",
      "maxLength": 1000,
      "minLength": 1
    },
    "attempted": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "what",
          "why"
        ],
        "properties": {
          "what": {
            "type": "string",
            "maxLength": 300,
            "minLength": 1
          },
          "why": {
            "type": "string",
            "maxLength": 400,
            "minLength": 1
          }
        }
      }
    },
    "approaches": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "description",
          "outcome",
          "evidence",
          "lesson"
        ],
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 150,
            "minLength": 1
          },
          "description": {
            "type": "string",
            "maxLength": 600,
            "minLength": 1
          },
          "outcome": {
            "enum": [
              "adopted",
              "abandoned",
              "failed",
              "inconclusive"
            ]
          },
          "evidence": {
            "type": "string",
            "maxLength": 600
          },
          "lesson": {
            "type": "string",
            "maxLength": 250
          }
        }
      }
    },
    "failures": {
      "type": "array",
      "minItems": 0,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "what",
          "evidence"
        ],
        "properties": {
          "what": {
            "type": "string",
            "maxLength": 300,
            "minLength": 1
          },
          "evidence": {
            "type": "string",
            "maxLength": 500
          }
        }
      }
    },
    "open_items": {
      "type": "array",
      "minItems": 0,
      "maxItems": 10,
      "items": {
        "type": "string",
        "maxLength": 300,
        "minLength": 1
      }
    },
    "verification": {
      "type": "array",
      "minItems": 0,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "check",
          "result",
          "evidence"
        ],
        "properties": {
          "check": {
            "type": "string",
            "maxLength": 300,
            "minLength": 1
          },
          "result": {
            "enum": [
              "passed",
              "failed",
              "not_run"
            ]
          },
          "evidence": {
            "type": "string",
            "maxLength": 300
          }
        }
      }
    },
    "revisited": {
      "type": "array",
      "minItems": 0,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "history_entry",
          "new_evidence"
        ],
        "properties": {
          "history_entry": {
            "type": "string",
            "maxLength": 150,
            "minLength": 1
          },
          "new_evidence": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1
          }
        }
      }
    },
    "review_loop": {
      "type": "object",
      "additionalProperties": false,
      "description": "The review loop of the run (at most 3 rounds of fresh read-only reviewers, each followed by a fix pass): how many rounds ran, the digest of the series each round reviewed, why the loop stopped, and every finding the reviewers made with what became of it. Required of a Result that delivers a series; trusted code publishes nothing while a P0 finding is open, a P0 finding is closed only by a later round than the one that raised it, and the last round must have reviewed exactly the series that is delivered.",
      "required": [
        "rounds",
        "round_digests",
        "stopped_because",
        "findings",
        "summary"
      ],
      "properties": {
        "rounds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "round_digests": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "description": "The SHA-256 of the series (the `git format-patch --stdout` bytes of the delivered `patches.mbox`) that the reviewers of each round read, one entry per round in order."
        },
        "stopped_because": {
          "enum": [
            "clean",
            "optional_only",
            "decision_needed",
            "cap_reached",
            "deadline"
          ]
        },
        "findings": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "severity",
              "status",
              "round",
              "closed_in_round",
              "title",
              "detail",
              "resolution"
            ],
            "properties": {
              "severity": {
                "enum": [
                  "P0",
                  "P1",
                  "P2"
                ]
              },
              "status": {
                "enum": [
                  "open",
                  "fixed",
                  "withdrawn",
                  "deferred"
                ]
              },
              "round": {
                "type": "integer",
                "minimum": 1,
                "maximum": 3
              },
              "closed_in_round": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 3
                  }
                ]
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 150
              },
              "detail": {
                "type": "string",
                "maxLength": 400
              },
              "resolution": {
                "type": "string",
                "maxLength": 250
              }
            }
          }
        },
        "summary": {
          "type": "string",
          "maxLength": 1000
        }
      }
    }
  }
}
