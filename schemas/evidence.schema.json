{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Evidence record (CI, release acceptance, plan, probe)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_id",
    "kind",
    "policy_version",
    "collected_at",
    "summary"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "evidence_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,127}$"
    },
    "contribution_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,127}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "kind": {
      "enum": [
        "ci",
        "probe",
        "release_acceptance",
        "plan",
        "target_contract",
        "rehearsal",
        "submission_rewrite",
        "submission_review",
        "benchmark",
        "merge",
        "human_relay",
        "human_inquiry",
        "resolution",
        "worker_report",
        "human_steering",
        "work_history",
        "series_requirements",
        "patch_review"
      ]
    },
    "policy_version": {
      "type": "string"
    },
    "collected_at": {
      "type": "string",
      "format": "date-time"
    },
    "summary": {
      "type": "string",
      "maxLength": 8000
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 1000
      }
    },
    "debug_present": {
      "type": "boolean"
    },
    "ci": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository_id": {
          "type": "integer"
        },
        "repository": {
          "type": "string"
        },
        "head_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "candidate_head_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "base_sha": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{40}$"
        },
        "test_merge_sha": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{40}$"
        },
        "workflow_id": {
          "type": "integer"
        },
        "workflow_path": {
          "type": "string"
        },
        "workflow_sha": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{40}$"
        },
        "event": {
          "type": "string"
        },
        "run_id": {
          "type": "integer"
        },
        "run_attempt": {
          "type": "integer",
          "minimum": 1
        },
        "jobs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "job_id",
              "name",
              "status",
              "conclusion",
              "executed",
              "runner_labels"
            ],
            "properties": {
              "job_id": {
                "type": "integer"
              },
              "name": {
                "type": "string"
              },
              "status": {
                "type": "string"
              },
              "conclusion": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "executed": {
                "type": "boolean"
              },
              "interrupted": {
                "type": "boolean"
              },
              "runner_labels": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "expected_wheels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "artifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "filename",
              "sha256",
              "producer_job_id"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "filename": {
                "type": "string"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "producer_job_id": {
                "type": "integer"
              }
            }
          }
        }
      },
      "required": [
        "repository_id",
        "head_sha",
        "workflow_path",
        "event",
        "run_id",
        "run_attempt",
        "jobs"
      ]
    },
    "data": {
      "type": "object"
    },
    "digests": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation_id",
        "disposition",
        "command_id",
        "comment_id",
        "issue_number",
        "content_digest",
        "actor",
        "reason",
        "operation"
      ],
      "properties": {
        "operation_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,127}$"
        },
        "disposition": {
          "enum": [
            "confirmed",
            "failed",
            "not-launched"
          ]
        },
        "command_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,127}$"
        },
        "comment_id": {
          "type": "integer",
          "minimum": 1
        },
        "issue_number": {
          "type": "integer",
          "minimum": 1
        },
        "content_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "actor": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "login"
          ],
          "properties": {
            "id": {
              "type": "integer",
              "minimum": 1
            },
            "login": {
              "type": "string",
              "maxLength": 39
            }
          }
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "operation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "status",
            "revision",
            "launch_attempts",
            "discoveries",
            "updated_at"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "maxLength": 64
            },
            "status": {
              "enum": [
                "planned",
                "applying",
                "uncertain"
              ]
            },
            "revision": {
              "type": "integer",
              "minimum": 0
            },
            "launch_attempts": {
              "type": "integer",
              "minimum": 0
            },
            "discoveries": {
              "type": "integer",
              "minimum": 0
            },
            "updated_at": {
              "type": "string",
              "format": "date-time"
            }
          }
        },
        "contribution_state": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        },
        "paused": {
          "type": "boolean"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "resolution"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "resolution",
          "contribution_id"
        ]
      }
    }
  ]
}
